# Apenas modelo. Substitua a senha e gere uma chave antes de executar.
POSTGRES_USER=jabuti
POSTGRES_PASSWORD=replace_with_a_local_password
POSTGRES_DB=jabutidb
# Use os mesmos valores de POSTGRES_* na URL; codifique caracteres especiais da senha.
DATABASE_URL=postgresql+asyncpg://jabuti:replace_with_a_local_password@db:5432/jabutidb
REDIS_URL=redis://cache:6379/0
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=
CACHE_ENABLED=true
CACHE_TTL=60
APP_NAME=Jabuti API
APP_ENV=development
APP_DEBUG=false
LOG_LEVEL=INFO
